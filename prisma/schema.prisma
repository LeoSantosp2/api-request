generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Users {
  id         String   @id
  first_name String
  last_name  String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  refreshToken RefreshToken[]
}

model RefreshToken {
  id         String   @id
  user_id    String
  users      Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String   @unique
  expires_at DateTime @unique
  revoked_at DateTime?
  created_at DateTime @default(now())

  @@map("refresh_token")
}
